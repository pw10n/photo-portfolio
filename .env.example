# Copy to .env (gitignored) and fill in. Loaded by `npm run cf:setup`,
# `npm run publish`, and `npm run deploy` via Node's --env-file flag.

# ── Cloudflare account ──────────────────────────────────────────────────────
# Dashboard sidebar → "Account ID" (long hex string). Used to build the R2
# S3 endpoint: https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID=

# Dashboard → My Profile → API Tokens → "Create Token" → Custom token.
# Permissions:
#   • Account → Cloudflare Pages → Edit
#   • Account → Workers R2 Storage → Edit
#   • Zone → DNS → Edit               (scope: prenticew.com)
#   • Zone → Zone → Read              (scope: prenticew.com)  ← needed for
#       cf_setup zone-id lookup. Skip if you set CF_ZONE_ID below.
# Account/zone scope: limit to your single account + the prenticew.com zone.
# Used by wrangler for pages deploy + r2 bucket provisioning.
CLOUDFLARE_API_TOKEN=

# Optional. Zone ID for prenticew.com (or whatever zone hosts your custom
# domains). Visible in the dashboard sidebar of any page inside the zone.
# Setting this skips the API-based zone-id lookup in cf_setup.mjs.
CF_ZONE_ID=

# ── R2 S3-compatible API credentials ────────────────────────────────────────
# Dashboard → R2 → "Manage R2 API Tokens" → Create API token.
# Permission: "Object Read & Write" scoped to the photo-portfolio bucket.
# Used by publish.mjs (@aws-sdk/client-s3) to PUT derivatives + originals.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Resource names (defaults match site.yaml + plan §9) ─────────────────────
R2_BUCKET=photo-portfolio
R2_PUBLIC_HOSTNAME=assets.prenticew.com
CF_PAGES_PROJECT=photo-portfolio

# Shadow deploy target (plan §9). Becomes prod after DNS cutover.
CF_PAGES_SHADOW_HOSTNAME=sgallery.prenticew.com
