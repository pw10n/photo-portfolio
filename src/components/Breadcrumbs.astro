---
interface Crumb {
  name: string;
  url: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const items = [{ name: 'Home', url: '/' }, ...crumbs];
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1;
        return (
          <li>
            {isLast ? (
              <span aria-current="page">{item.name}</span>
            ) : (
              <a href={item.url}>{item.name}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs li + li::before {
    content: '/';
    margin: 0 0.4rem;
    color: var(--border);
  }

  .breadcrumbs a {
    color: var(--muted);
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--fg);
  }
</style>
