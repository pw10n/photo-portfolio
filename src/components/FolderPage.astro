---
import type { Album, Folder } from '../content/config';
import Breadcrumbs from './Breadcrumbs.astro';
import Thumbnail from './Thumbnail.astro';

interface Props {
  folder: Folder;
  childFolders: Folder[];
  childAlbums: Album[];
}

const { folder, childFolders, childAlbums } = Astro.props;

function buildCrumbs(f: Folder): Array<{ name: string; url: string }> {
  const segments = f.url_path.split('/').filter(Boolean);
  const crumbs: Array<{ name: string; url: string }> = [];
  let acc = '';
  for (let i = 0; i < segments.length; i++) {
    acc += '/' + segments[i];
    crumbs.push({ name: segments[i], url: acc });
  }
  if (crumbs.length > 0) crumbs[crumbs.length - 1].name = f.name;
  return crumbs;
}

const crumbs = buildCrumbs(folder);

function heroImageIdFor(album: Album): string | null {
  if (album.images.length === 0) return null;
  if (album.hero) {
    const found = album.images.find((img) => img.filename === album.hero);
    if (found) return found.image_id;
  }
  return album.images[0].image_id;
}

const publicChildFolders = childFolders.filter((f) => f.privacy === 'public');
const publicChildAlbums = childAlbums.filter((a) => a.privacy === 'public');
---

<Breadcrumbs crumbs={crumbs} />

<header class="folder-header">
  <h1>{folder.name}</h1>
  {folder.description && <p class="description">{folder.description}</p>}
</header>

{
  publicChildFolders.length > 0 && (
    <section class="folder-section">
      <h2>Folders</h2>
      <ul class="folder-grid">
        {publicChildFolders.map((f) => (
          <li>
            <a href={f.url_path} class="folder-tile">
              <span class="folder-name">{f.name}</span>
              <span class="folder-count">{f.child_paths.length} item{f.child_paths.length === 1 ? '' : 's'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  publicChildAlbums.length > 0 && (
    <section class="folder-section">
      <h2>Albums</h2>
      <ul class="thumb-grid">
        {publicChildAlbums.map((album) => {
          const heroId = heroImageIdFor(album);
          return (
            <li>
              <a href={album.url_path}>
                <div class="thumb">
                  {heroId ? (
                    <Thumbnail imageId={heroId} alt={album.name} />
                  ) : (
                    <div class="thumb-placeholder" />
                  )}
                </div>
                <span class="thumb-label">
                  {album.name}
                  {album.date && <span class="meta">{album.date}</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

{publicChildFolders.length === 0 && publicChildAlbums.length === 0 && (
  <p class="empty">No public content in this folder yet.</p>
)}

<style>
  .folder-header {
    margin-bottom: 2rem;
  }
  .folder-header h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }
  .folder-header .description {
    color: var(--muted);
    margin: 0;
  }
  .folder-section {
    margin-bottom: 3rem;
  }
  .folder-section h2 {
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .folder-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--gap);
  }
  .folder-tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem 1rem;
    border: 1px solid var(--border);
    background: var(--bg);
    aspect-ratio: 4 / 3;
    transition: border-color 120ms ease;
  }
  .folder-tile:hover {
    border-color: var(--fg);
    text-decoration: none;
  }
  .folder-name {
    font-size: 1.125rem;
    font-weight: 500;
  }
  .folder-count {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .thumb-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--border);
  }
  .empty {
    color: var(--muted);
    padding: 2rem 0;
  }
</style>
